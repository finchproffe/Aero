                    <Button x:Name="BookmarksLibraryButton" Grid.Column="1" Height="32" Click="BookmarksLibraryButton_Click" Content="Bookmarks" />
                </Grid>

                <TextBox
                    x:Name="LibrarySearchBox"
                    Grid.Row="2"
                    Height="32"
                    Margin="0,0,0,12"
                    Padding="12,0"
                    PlaceholderText="Search"
                    TextChanged="LibrarySearchBox_TextChanged" />

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LibraryItemsPanel" Spacing="6" />
                    </ScrollViewer>
                    <StackPanel
                        x:Name="LibraryEmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7"
                        Visibility="Collapsed">
                        <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource AeroMutedTextBrush}" Glyph="&#xE81C;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Nothing here yet" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Pages you visit or save will appear here." />
                    </StackPanel>
                </Grid>

                <Button
                    x:Name="ClearHistoryButton"
                    Grid.Row="4"
                    Height="32"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Padding="16,0"
                    Click="ClearHistoryButton_Click"
                    Content="Clear history" />
            </Grid>
        </Border>

