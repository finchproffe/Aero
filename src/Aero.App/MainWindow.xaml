            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1,0,0,0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="DownloadsPaneTransform" TranslateX="26" />
            </Border.RenderTransform>

            <Grid Padding="15,13,15,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Downloads" />
                        <TextBlock x:Name="DownloadsSummaryText" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="No downloads yet" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ChromeIconButtonStyle}" Click="CloseDownloadsButton_Click" AutomationProperties.Name="Close"
                    ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Aero asks where to save each file." />
                    <Button Grid.Column="1" Height="30" Padding="12,0" Click="OpenDownloadsFolderButton_Click" Content="Open folder" />
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DownloadsItemsPanel" Spacing="8" />
                    </ScrollViewer>
                    <StackPanel x:Name="DownloadsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                        <FontIcon HorizontalAlignment="Center" FontSize="30" Foreground="{ThemeResource AeroMutedTextBrush}" Glyph="&#xE896;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Nothing downloaded yet" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Active and recent downloads will appear here." />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Saved tab sets and workspace foundation. -->
        <Border
            x:Name="WorkspacesPane"
            Grid.Row="5"
            Canvas.ZIndex="45"
            Width="410"
            HorizontalAlignment="Right"
            Background="{ThemeResource AeroSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1,0,0,0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="WorkspacesPaneTransform" TranslateX="28" />
            </Border.RenderTransform>

            <Grid Padding="17,14,17,17" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Workspaces" />
                        <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Save and reopen complete tab sets." />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ChromeIconButtonStyle}" Click="CloseWorkspacesButton_Click" AutomationProperties.Name="Close"
                    ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Padding="12" Background="{ThemeResource AeroRaisedSurfaceBrush}" CornerRadius="11">
                    <StackPanel Spacing="9">
                        <TextBox
                            x:Name="WorkspaceNameBox"
                            Header="Workspace name"
                            PlaceholderText="Research, work, music…" />
                        <Button
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="SaveWorkspaceButton_Click"
                            Content="Save current tabs" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="WorkspacesListPanel" Spacing="8" />
                    </ScrollViewer>
                    <StackPanel
                        x:Name="WorkspacesEmptyState"
                        Margin="0,42"
                        HorizontalAlignment="Center"
                        Spacing="7">
                        <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource AeroMutedTextBrush}" Glyph="&#xE8B7;" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource AeroMutedTextBrush}" Text="No saved workspaces yet" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="WorkspacesStatusText"
                    Grid.Row="3"
                    FontSize="12"
                    Foreground="{ThemeResource AeroMutedTextBrush}"
                    Text="Save the current tab set to reopen it later."
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Password and autofill center. -->
        <Border
            x:Name="PasswordsPane"
            Grid.Row="5"
            Canvas.ZIndex="45"
            Width="390"
            HorizontalAlignment="Right"
            Background="{ThemeResource AeroSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1,0,0,0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PasswordsPaneTransform" TranslateX="28" />
            </Border.RenderTransform>

            <Grid Padding="17,14,17,17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Passwords &amp; autofill" />
                        <TextBlock x:Name="PasswordsStatusText" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Password profile is initializing" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ChromeIconButtonStyle}" Click="ClosePasswordsButton_Click" AutomationProperties.Name="Close"
                    ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Padding="14" Background="{ThemeResource AeroRaisedSurfaceBrush}" BorderBrush="{ThemeResource AeroBorderBrush}" BorderThickness="1" CornerRadius="11">
                            <StackPanel Spacing="12">
                                <ToggleSwitch
                                    x:Name="PasswordsSaveToggle"
                                    Header="Enable Aero Vault"
                                    OffContent="Disabled"
                                    OnContent="Enabled"
                                    Toggled="PasswordFeatureToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="PasswordsAutofillToggle"
                                    Header="Autofill addresses and forms"
                                    OffContent="Disabled"
                                    OnContent="Enabled"
                                    Toggled="PasswordFeatureToggle_Toggled" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="LOCAL DATA" />
                            <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Text="Aero Vault 2.3 protects sign-ins with Windows Hello and, when a TPM is available, a hardware-backed Node Lock bound to this device. Each protected operation is one-shot and decrypted key material is destroyed immediately." />
                            <TextBlock x:Name="PasswordVaultCountText" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Checking protected sign-ins…" />
                            <Button x:Name="ViewSavedPasswordsButton" Height="34" HorizontalAlignment="Left" Padding="14,0" Click="ViewSavedPasswordsButton_Click" Content="View saved passwords" />
                            <Button x:Name="ClearSavedPasswordsButton" Height="34" HorizontalAlignment="Left" Padding="14,0" Click="ClearSavedPasswordsButton_Click" Content="Clear Aero Vault" />
                            <Button x:Name="ClearAutofillDataButton" Height="34" HorizontalAlignment="Left" Padding="14,0" Click="ClearAutofillDataButton_Click" Content="Clear form autofill data" />
                        </StackPanel>

                        <Border Padding="13" Background="{ThemeResource AeroAddressBrush}" BorderBrush="{ThemeResource AeroSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Text="WebView2 password persistence is disabled to avoid a second credential database. Aero decrypts only the selected site entry, fills the top-level HTTPS page, then clears its temporary byte buffers." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Chromium extensions lab. -->
        <Border
            x:Name="ExtensionsPane"
            Grid.Row="5"
            Canvas.ZIndex="45"
            Width="420"
            HorizontalAlignment="Right"
            Background="{ThemeResource AeroSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1,0,0,0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="ExtensionsPaneTransform" TranslateX="28" />
            </Border.RenderTransform>

            <Grid Padding="16,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Extensions" />
                        <TextBlock x:Name="ExtensionsStatusText" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Extension profile is initializing" />
                    </StackPanel>
                    <Button
                        x:Name="RefreshExtensionsButton"
                        Grid.Column="1"
                        Margin="0,0,4,0"
                        Style="{StaticResource ChromeIconButtonStyle}"
                        Click="RefreshExtensionsButton_Click"
                        AutomationProperties.Name="Refresh extensions"
                    ToolTipService.ToolTip="Refresh extensions">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ChromeIconButtonStyle}" Click="CloseExtensionsButton_Click" AutomationProperties.Name="Close"
                    ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,15,0,10" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ImportChromeExtensionsButton" Height="34" Padding="12,0" Click="ImportChromeExtensionsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Glyph="&#xE8B5;" />
                                <TextBlock Text="Import from Chrome" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Height="34" Padding="12,0" Click="InstallUnpackedExtensionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Load unpacked" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ExtensionsSearchBox"
                            Height="34"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Search extensions"
                            TextChanged="ExtensionsSearchBox_TextChanged" />
                        <Button Grid.Column="1" Height="34" Padding="12,0" Click="OpenChromeWebStoreButton_Click" Content="Web Store" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="2" Margin="0,0,0,12" Padding="12" Background="{ThemeResource AeroAddressBrush}" BorderBrush="{ThemeResource AeroSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Text="Open Web Store and choose Add to Chrome: Aero will check the package format, show its permissions, then unpack and install a compatible CRX into the current profile. Import from Chrome and unpacked Manifest V2/V3 folders are also supported." />
                </Border>

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ExtensionsItemsPanel" Spacing="8" />
                    </ScrollViewer>
                    <StackPanel x:Name="ExtensionsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                        <FontIcon HorizontalAlignment="Center" FontSize="30" Foreground="{ThemeResource AeroMutedTextBrush}" Glyph="&#xEA86;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="No extensions installed" />
                        <TextBlock x:Name="ExtensionsEmptyDescription" Width="300" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Text="Install from Web Store, import from Chrome, or load an unpacked Chromium extension folder." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Page zoom indicator. -->
        <Border
            x:Name="ZoomToast"
            Grid.Row="5"
            Canvas.ZIndex="59"
            MinWidth="210"
            Height="48"
            Margin="0,12,14,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Padding="8,0"
            Background="{ThemeResource AeroRaisedSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="ZoomToastTransform" TranslateY="-8" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="32" Height="32" Style="{StaticResource ChromeIconButtonStyle}" Click="PageZoomOutButton_Click" AutomationProperties.Name="Zoom out"
                    ToolTipService.ToolTip="Zoom out">
                    <FontIcon FontSize="11" Glyph="&#xE738;" />
                </Button>
                <TextBlock x:Name="ZoomToastText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="100%" />
                <Button Grid.Column="2" Width="32" Height="32" Style="{StaticResource ChromeIconButtonStyle}" Click="PageZoomInButton_Click" AutomationProperties.Name="Zoom in"
                    ToolTipService.ToolTip="Zoom in">
                    <FontIcon FontSize="11" Glyph="&#xE710;" />
                </Button>
                <Button Grid.Column="3" Height="30" Padding="9,0" Click="PageZoomResetButton_Click" Content="Reset" />
            </Grid>
        </Border>

        <!-- Download started/completed toast. -->
        <Border
            x:Name="DownloadToast"
            Grid.Row="5"
            Canvas.ZIndex="58"
            Width="330"
            MinHeight="66"
            Margin="0,0,14,14"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Padding="14,10"
            Background="{ThemeResource AeroRaisedSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="DownloadToastTransform" TranslateY="12" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE896;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="DownloadToastTitle" FontSize="12" FontWeight="SemiBold" Text="Download started" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DownloadToastSubtitle" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Open downloads to see progress" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="DownloadToastViewButton" Grid.Column="2" Height="30" Padding="11,0" Click="DownloadToastButton_Click" Content="View" />
            </Grid>
        </Border>

        <!-- Crash recovery banner for the active tab. -->
        <Border
            x:Name="RecoveryBar"
            Grid.Row="5"
            Canvas.ZIndex="46"
            Height="48"
            Margin="10,10,10,0"
            VerticalAlignment="Top"
            Padding="14,0"
            Background="{ThemeResource AeroRaisedSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE783;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="This tab stopped responding. Your other tabs are safe." />
                <Button Grid.Column="2" Height="30" Padding="12,0" Click="ReloadCrashedTabButton_Click" Content="Reload" />
                <Button Grid.Column="3" Width="30" Height="30" Style="{StaticResource ChromeIconButtonStyle}" Click="DismissRecoveryBarButton_Click">
                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <!-- Command palette. -->
        <Border
            x:Name="CommandPaletteScrim"
            Grid.RowSpan="7"
            Canvas.ZIndex="70"
            Background="{ThemeResource AeroScrimBrush}"
            Opacity="0"
            Visibility="Collapsed"
            Tapped="CommandPaletteScrim_Tapped" />

        <Border
            x:Name="CommandPalette"
            Grid.RowSpan="7"
            Canvas.ZIndex="71"
            Width="620"
            MaxHeight="520"
            Margin="0,58,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Padding="10"
            Background="{ThemeResource AeroRaisedSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1"
            CornerRadius="15"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="CommandPaletteTransform" TranslateY="-10" ScaleX="0.985" ScaleY="0.985" />
            </Border.RenderTransform>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Margin="8,0,0,0" FontSize="15" Glyph="&#xE721;" />
                    <TextBox
                        x:Name="CommandPaletteBox"
                        Grid.Column="1"
                        Height="40"
                        Padding="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        PlaceholderText="Search tabs, history, bookmarks, or type a command"
                        TextChanged="CommandPaletteBox_TextChanged"
                        KeyDown="CommandPaletteBox_KeyDown" />
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="ESC" />
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{ThemeResource AeroSoftBorderBrush}" />
                <ScrollViewer Grid.Row="2" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CommandPaletteResultsPanel" Spacing="3" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Settings pane. It is intentionally simple and fast. -->
        <Border
            x:Name="SettingsScrim"
            Grid.RowSpan="7"
            Canvas.ZIndex="50"
            Background="{ThemeResource AeroScrimBrush}"
            Opacity="0"
            Visibility="Collapsed"
            Tapped="SettingsScrim_Tapped" />

        <Border
            x:Name="SettingsPane"
            Grid.RowSpan="7"
            Canvas.ZIndex="51"
            Width="330"
            HorizontalAlignment="Right"
            Background="{ThemeResource AeroSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1,0,0,0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="SettingsPaneTransform" TranslateX="28" />
            </Border.RenderTransform>

            <Grid Padding="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Settings" />
                        <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" Text="Import, export and protected profile backups for Aero 0.22" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource ChromeIconButtonStyle}"
                        Click="CloseSettingsButton_Click"
                        AutomationProperties.Name="Close settings"
                    ToolTipService.ToolTip="Close settings">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,22,0,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="9">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="PERFORMANCE" />
                            <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" Text="Maximum mode is the default and prioritizes foreground page speed." TextWrapping="Wrap" />
                            <ComboBox x:Name="SpeedModeComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="Maximum speed" />
                                <ComboBoxItem Content="Balanced" />
                                <ComboBoxItem Content="Compatibility" />
                            </ComboBox>
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="TrackerBlockingToggle"
                            Header="Aero Shield"
                            OffContent="Ads and trackers allowed"
                            OnContent="Block known ads and trackers" />

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Shield engine" />
                            <ComboBox x:Name="ShieldEngineSettingsComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="Hybrid — recommended" />
                                <ComboBoxItem Content="Advanced — uBlock Origin" />
                                <ComboBoxItem Content="Native — Aero only" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Shield mode" />
                            <ComboBox x:Name="ShieldModeSettingsComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="Standard" />
                                <ComboBoxItem Content="Strict" />
                            </ComboBox>
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="ShieldCosmeticSettingsToggle"
                            Header="Hide ad placeholders"
                            OffContent="Network blocking only"
                            OnContent="Apply cosmetic filters" />

                        <ToggleSwitch
                            x:Name="ShieldAutoUpdateToggle"
                            Header="Update filter lists automatically"
                            OffContent="Manual updates"
                            OnContent="Refresh every 24 hours" />

                        <ToggleSwitch
                            x:Name="ShieldYoutubeSettingsToggle"
                            Header="YouTube clean mode"
                            OffContent="No extra YouTube cleanup"
                            OnContent="Remove promoted UI and activate Skip buttons" />

                        <ToggleSwitch
                            x:Name="CleanLinksToggle"
                            Header="Clean tracking links"
                            OffContent="Keep original links"
                            OnContent="Remove common tracking parameters" />

                        <StackPanel Spacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="MEMORY SAVER" />
                            <TextBlock
                                Foreground="{ThemeResource AeroMutedTextBrush}"
                                Text="Reduce RAM without closing pages. Background tabs are frozen in place and resume without reloading."
                                TextWrapping="Wrap" />
                            <ComboBox x:Name="MemorySaverModeComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="Maximum — freeze tabs sooner" />
                                <ComboBoxItem Content="Balanced — freeze after 3 minutes" />
                                <ComboBoxItem Content="Off" />
                            </ComboBox>
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="SleepTabsToggle"
                            Header="Sleep background tabs"
                            OffContent="Keep every tab active"
                            OnContent="Reduce inactive tabs automatically" />

                        <ToggleSwitch
                            x:Name="KeepAudioTabsAwakeToggle"
                            Header="Keep audio tabs awake"
                            OffContent="Background media may be paused"
                            OnContent="Do not sleep tabs that are playing audio" />

                        <Button
                            Height="32"
                            HorizontalAlignment="Left"
                            Padding="14,0"
                            Click="FreeMemoryNowButton_Click"
                            Content="Freeze background tabs now" />

                        <TextBlock
                            x:Name="MemorySaverStatusText"
                            Foreground="{ThemeResource AeroMutedTextBrush}"
                            FontSize="12"
                            Text="Foreground performance is protected; background tabs will be reduced automatically."
                            TextWrapping="Wrap" />

                        <Border Height="1" Background="{ThemeResource AeroSoftBorderBrush}" />

                        <StackPanel Spacing="9">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="PASSWORDS &amp; AUTOFILL" />
                            <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" Text="Aero Vault 2.3 uses Windows Hello plus a TPM-backed Node Lock when supported. There is no persistent unlocked state: decrypted key material exists only for the current operation." TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="SavePasswordsToggle"
                                Header="Enable Aero Vault"
                                OffContent="Do not save new passwords"
                                OnContent="Save and autofill sign-ins" />
                            <ToggleSwitch
                                x:Name="AutofillFormsToggle"
                                Header="Autofill forms"
                                OffContent="Do not save form details"
                                OnContent="Suggest saved form details" />
                            <Button Height="32" HorizontalAlignment="Left" Padding="14,0" Click="OpenPasswordsFromSettingsButton_Click" Content="Manage password data" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource AeroSoftBorderBrush}" />

                        <StackPanel Spacing="9">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="APPEARANCE" />
                            <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" Text="Choose how Aero looks." />
                            <ComboBox x:Name="ThemeComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Use Windows setting" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource AeroSoftBorderBrush}" />

                        <StackPanel Spacing="9">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="NEW TAB" />
                            <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" Text="Choose what opens in a new tab." />
                            <ComboBox x:Name="NewTabComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="Aero Home" />
                                <ComboBoxItem Content="Google" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource AeroSoftBorderBrush}" />

                        <ToggleSwitch
                            x:Name="QuickLinksToggle"
                            Header="Quick links on Aero Home"
                            OffContent="Hidden"
                            OnContent="Visible" />

                        <ToggleSwitch
                            x:Name="RestoreSessionToggle"
                            Header="Restore tabs after restart"
                            OffContent="Start fresh"
                            OnContent="Restore session" />

                        <TextBlock
                            Foreground="{ThemeResource AeroMutedTextBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Text="Settings are stored locally on this computer. Aero does not sync them anywhere." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Height="34" Padding="14,0" Click="CancelSettingsButton_Click" Content="Cancel" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettingsButton_Click" Content="Save changes" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Address bar history suggestions. The popup is positioned below AddressSurface in code. -->
        <Popup
            x:Name="AddressSuggestionsPopup"
            IsLightDismissEnabled="False">
            <Popup.ChildTransitions>
                <TransitionCollection>
                    <PopupThemeTransition />
                </TransitionCollection>
            </Popup.ChildTransitions>
            <Border
                x:Name="AddressSuggestionsPanel"
                Padding="6"
                Background="{ThemeResource AeroRaisedSurfaceBrush}"
                BorderBrush="{ThemeResource AeroSoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ListView
                    x:Name="AddressSuggestionsList"
                    MaxHeight="360"
                    IsItemClickEnabled="True"
                    ItemClick="AddressSuggestionsList_ItemClick"
                    PointerPressed="AddressSuggestionsList_PointerPressed"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AeroAddressBrush}"
                                    CornerRadius="8">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Glyph="{Binding Glyph}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource AeroMutedTextBrush}"
                                        Text="{Binding DisplayUrl}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Margin="8,0,2,0"
                                    Padding="7,3"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AeroAddressBrush}"
                                    CornerRadius="7">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource AeroMutedTextBrush}"
                                        Text="{Binding SourceLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>

        <!-- Full-window visual layer keeps a dragged tab above the page and shows Split View drop zones. -->
        <Canvas
            x:Name="TabDragOverlay"
            Grid.RowSpan="7"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Canvas.ZIndex="1000"
            IsHitTestVisible="False">
            <Border
                x:Name="SplitDropIndicator"
                Canvas.ZIndex="50"
                Background="{ThemeResource AeroHoverBrush}"
                BorderBrush="{ThemeResource AeroAccentBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Opacity="0.92"
                Visibility="Collapsed" />
        </Canvas>

    </Grid>
</Window>
