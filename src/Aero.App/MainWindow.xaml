<Window
    x:Class="Aero.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aero.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aero">

    <Grid
        x:Name="RootGrid"
        Loaded="RootGrid_Loaded"
        KeyDown="RootGrid_PageToolsKeyDown"
        KeyboardAcceleratorPlacementMode="Hidden"
        Background="{ThemeResource AeroWindowBrush}"
        RequestedTheme="Dark">

        <Grid.Resources>
            <Style TargetType="FlyoutPresenter">
                <Setter Property="BorderBrush" Value="{ThemeResource AeroSoftBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewWindowAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="NewPrivateWindowAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="RestoreTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusAddressAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="BookmarkAccelerator_Invoked" />
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="HistoryAccelerator_Invoked" />
            <KeyboardAccelerator Key="J" Modifiers="Control" Invoked="DownloadsAccelerator_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPaletteAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="CommandPaletteAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control,Shift" Invoked="ExtensionsAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Modifiers="Shift" Invoked="TaskManagerAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="ShieldAccelerator_Invoked" />
            <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="MuteTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked" />
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomResetAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="PrintPageAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccelerator_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="FindNextAccelerator_Invoked" />
            <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="FindPreviousAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullscreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="PreviousTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="ReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="StopAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="SelectTabByNumberAccelerator_Invoked" />
            <KeyboardAccelerator Key="PageDown" Modifiers="Control" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="PageUp" Modifiers="Control" Invoked="PreviousTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="HardReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Modifiers="Control" Invoked="HardReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Modifiers="Shift" Invoked="HardReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Modifiers="Menu" Invoked="FocusAddressAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="FocusAddressAccelerator_Invoked" />
            <KeyboardAccelerator Key="Home" Modifiers="Menu" Invoked="HomeAccelerator_Invoked" />
            <KeyboardAccelerator Key="B" Modifiers="Control,Shift" Invoked="ToggleBookmarksBarAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="BookmarksLibraryAccelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Modifiers="Control,Shift" Invoked="ClearBrowsingDataAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control,Shift" Invoked="CloseWindowAccelerator_Invoked" />
            <KeyboardAccelerator Key="PageUp" Modifiers="Control,Shift" Invoked="MoveTabLeftAccelerator_Invoked" />
            <KeyboardAccelerator Key="PageDown" Modifiers="Control,Shift" Invoked="MoveTabRightAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="SearchTabsAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Menu" Invoked="MainMenuAccelerator_Invoked" />
            <KeyboardAccelerator Key="F10" Invoked="MainMenuAccelerator_Invoked" />
            <KeyboardAccelerator Key="F12" Invoked="DevToolsAccelerator_Invoked" />
            <KeyboardAccelerator Key="I" Modifiers="Control,Shift" Invoked="DevToolsAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40" />
            <RowDefinition x:Name="ToolbarRow" Height="48" />
            <RowDefinition x:Name="DockedTabRow" Height="0" />
            <RowDefinition x:Name="BookmarksBarRow" Height="0" />
            <RowDefinition x:Name="ProgressRow" Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomTabRow" Height="0" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. Native caption buttons remain on the right. -->
        <Grid
            x:Name="TitleBarSurface"
            Grid.Row="0"
            AllowDrop="True"
            DragEnter="BrowserFileDrop_DragEnter"
            DragLeave="BrowserFileDrop_DragLeave"
            DragOver="BrowserFileDrop_DragOver"
            Drop="BrowserFileDrop_Drop"
            SizeChanged="TitleBarSurface_SizeChanged"
            Background="{ThemeResource AeroTitleBarBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftTitleBarInsetColumn" Width="0" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition x:Name="RightTitleBarInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="TitleBarCustomBackground"
                Grid.ColumnSpan="5"
                Background="Transparent"
                IsHitTestVisible="False" />

            <Viewbox
                x:Name="TitleBarMountainLayer"
                Grid.ColumnSpan="5"
                Stretch="Fill"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Canvas Width="1200" Height="100">
                    <Path
                        x:Name="MountainBackPath"
                        Data="M 0,100 L 0,74 L 120,34 L 242,70 L 390,22 L 535,67 L 690,28 L 845,72 L 1010,36 L 1200,76 L 1200,100 Z"
                        Fill="#663C6685" />
                    <Path
                        x:Name="MountainMistPath"
                        Data="M 0,100 L 0,86 L 170,58 L 310,82 L 470,51 L 620,84 L 790,57 L 930,83 L 1080,55 L 1200,86 L 1200,100 Z"
                        Fill="#554E7DA0" />
                    <Path
                        x:Name="MountainFrontPath"
                        Data="M 0,100 L 0,91 L 155,70 L 286,90 L 455,62 L 640,91 L 805,69 L 972,91 L 1110,72 L 1200,91 L 1200,100 Z"
                        Fill="#775E91B3" />
                </Canvas>
            </Viewbox>

            <Button
                x:Name="TabListButton"
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="3,5"
                Style="{StaticResource ChromeIconButtonStyle}"
                Click="TabListButton_Click"
                AutomationProperties.Name="All tabs"
                    ToolTipService.ToolTip="All tabs">
                <FontIcon FontSize="11" Glyph="&#xE70D;" />
            </Button>

            <ScrollViewer
                x:Name="TabScrollViewer"
                Grid.Column="2"
                HorizontalAlignment="Left"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                PointerCaptureLost="TabScrollViewer_PointerCaptureLost"
                PointerExited="TabStripPointerExited"
                PointerMoved="TabScrollViewer_PointerMoved"
                PointerReleased="TabScrollViewer_PointerReleased"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <StackPanel
                    x:Name="TabStripHost"
                    Orientation="Horizontal"
                    Spacing="2">
                    <StackPanel
                        x:Name="TabStripPanel"
                        Orientation="Horizontal"
                        Spacing="2" />
                    <Button
                        x:Name="AddTabButton"
                        Width="28"
                        Height="28"
                        Margin="2,5,4,5"
                        VerticalAlignment="Top"
                        Style="{StaticResource ChromeIconButtonStyle}"
                        Click="AddTabButton_Click"
                        PointerPressed="AddTabButton_PointerPressed"
                        AutomationProperties.Name="New tab (Ctrl+T)"
                    ToolTipService.ToolTip="New tab (Ctrl+T)">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="3"
                Background="Transparent">
                <Border
                    x:Name="PrivateModeBadge"
                    Margin="12,5,8,5"
                    Padding="10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource AeroRaisedSurfaceBrush}"
                    BorderBrush="{ThemeResource AeroSoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72E;" />
                        <TextBlock x:Name="ProfileModeBadgeText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Private" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                x:Name="FileDropBadge"
                Grid.ColumnSpan="5"
                Margin="54,5,150,5"
                Padding="16,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Canvas.ZIndex="200"
                Background="#E61B252E"
                BorderBrush="{ThemeResource AeroAccentBrush}"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="9">
                    <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                    <TextBlock
                        x:Name="FileDropBadgeText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Drop files to open in Aero" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="4"
                Background="Transparent"
                IsHitTestVisible="False" />
        </Grid>

        <!-- Navigation toolbar. -->
        <Border
            x:Name="NavigationToolbarSurface"
            Grid.Row="1"
            Padding="8,5"
            Background="{ThemeResource AeroToolbarBrush}"
            BorderBrush="{ThemeResource AeroSoftBorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid
                x:Name="NavigationToolbarGrid"
                ColumnSpacing="3"
                SizeChanged="NavigationToolbarGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Capsules behind the navigation and action button groups; shown by interface styles. -->
                <Border
                    x:Name="NavGroupSurface"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <Border
                    x:Name="ActionGroupSurface"
                    Grid.Column="7"
                    Grid.ColumnSpan="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="BackButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Back (Alt+Left)"
                    ToolTipService.ToolTip="Back (Alt+Left)">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon FontSize="13" Glyph="&#xE72B;" />
                </Button>

                <Button
                    x:Name="ForwardButton"
                    Grid.Column="1"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="ForwardButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Forward (Alt+Right)"
                    ToolTipService.ToolTip="Forward (Alt+Right)">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon FontSize="13" Glyph="&#xE72A;" />
                </Button>

                <Button
                    x:Name="ReloadButton"
                    Grid.Column="2"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="ReloadButton_Click"
                    AutomationProperties.Name="Reload (Ctrl+R)"
                    ToolTipService.ToolTip="Reload (Ctrl+R)">
                    <FontIcon x:Name="ReloadIcon" FontSize="13" Glyph="&#xE72C;" />
                </Button>

                <Button
                    x:Name="HomeButton"
                    Grid.Column="3"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="HomeButton_Click"
                    AutomationProperties.Name="Aero Home"
                    ToolTipService.ToolTip="Aero Home">
                    <FontIcon FontSize="13" Glyph="&#xE80F;" />
                </Button>

                <Border
                    x:Name="AddressSurface"
                    Grid.Column="5"
                    Height="36"
                    Padding="6,0,4,0"
                    Background="{ThemeResource AeroAddressBrush}"
                    BorderBrush="{ThemeResource AeroAddressBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    PointerEntered="AddressSurface_PointerEntered"
                    PointerExited="AddressSurface_PointerExited"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="AddressSurfaceTransform" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>

                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="ShieldButton"
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            AutomationProperties.Name="Aero Shield"
                    ToolTipService.ToolTip="Aero Shield">
                            <Button.Flyout>
                                <Flyout
                                    x:Name="ShieldFlyout"
                                    Placement="Bottom"
                                    Opened="ShieldFlyout_Opened">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="CornerRadius" Value="14" />
                                            <Setter Property="MinWidth" Value="0" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Border
                                        Width="382"
                                        Padding="14"
                                        Background="{ThemeResource AeroRaisedSurfaceBrush}"
                                        CornerRadius="13">
                                        <ScrollViewer MaxHeight="570" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Aero Shield" />
                                                        <TextBlock
                                                            x:Name="ShieldSiteText"
                                                            Foreground="{ThemeResource AeroMutedTextBrush}"
                                                            FontSize="12"
                                                            Text="Open a website to manage protection"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <ToggleSwitch
                                                        x:Name="SiteShieldToggle"
                                                        Grid.Column="1"
                                                        OffContent=""
                                                        OnContent=""
                                                        Toggled="SiteShieldToggle_Toggled" />
                                                </Grid>

                                                <Border
                                                    Padding="12"
                                                    Background="{ThemeResource AeroSurfaceBrush}"
                                                    CornerRadius="10">
                                                    <StackPanel Spacing="8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Blocking engine" />
                                                                <TextBlock
                                                                    x:Name="UBlockEngineStatusText"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource AeroMutedTextBrush}"
                                                                    Text="Checking uBlock Origin…"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border
                                                                Grid.Column="1"
                                                                Padding="8,4"
                                                                Background="{ThemeResource AeroAddressBrush}"
                                                                CornerRadius="8">
                                                                <TextBlock
                                                                    x:Name="UBlockEngineBadgeText"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Text="Checking" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock
                                                            x:Name="UBlockEngineHelpText"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource AeroMutedTextBrush}"
                                                            Text="Aero native filtering remains active until uBlock Origin is ready."
                                                            TextWrapping="Wrap" />
                                                        <ComboBox
                                                            x:Name="ShieldEngineComboBox"
                                                            HorizontalAlignment="Stretch"
                                                            SelectionChanged="ShieldEngineComboBox_SelectionChanged">
                                                            <ComboBoxItem Content="Hybrid — Aero fast lane + uBlock Origin" />
                                                            <ComboBoxItem Content="Advanced — uBlock Origin only" />
                                                            <ComboBoxItem Content="Native — Aero engine only" />
                                                        </ComboBox>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button
                                                                x:Name="OpenUBlockControlsButton"
                                                                Height="30"
                                                                HorizontalAlignment="Stretch"
                                                                Click="OpenUBlockControlsButton_Click"
                                                                Content="Advanced controls"
                                                                Visibility="Collapsed" />
                                                            <Button
                                                                x:Name="RetryUBlockButton"
                                                                Grid.Column="1"
                                                                Height="30"
                                                                HorizontalAlignment="Stretch"
                                                                Click="RetryUBlockButton_Click"
                                                                Content="Retry install"
                                                                Visibility="Collapsed" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel x:Name="NativeShieldControls" Spacing="13">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Padding="12,10" Background="{ThemeResource AeroSurfaceBrush}" CornerRadius="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock x:Name="ShieldBlockedText" FontSize="20" FontWeight="SemiBold" Text="0" />
                                                            <TextBlock x:Name="ShieldSessionText" FontSize="12" Foreground="{ThemeResource AeroMutedTextBrush}" Text="blocked on page" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Padding="12,10" Background="{ThemeResource AeroSurfaceBrush}" CornerRadius="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock x:Name="ShieldRuleCountText" FontSize="20" FontWeight="SemiBold" Text="45" />
                                                            <TextBlock x:Name="ShieldRuleLabelText" FontSize="12" Foreground="{ThemeResource AeroMutedTextBrush}" Text="native rules" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Spacing="7">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Protection mode" />
                                                    <ComboBox
                                                        x:Name="ShieldModeComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        SelectionChanged="ShieldModeComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="Standard — fewer broken sites" />
                                                        <ComboBoxItem Content="Strict — stronger third-party blocking" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <ToggleSwitch
                                                    x:Name="ShieldCosmeticToggle"
                                                    Header="Hide ad placeholders"
                                                    OffContent="Network blocking only"
                                                    OnContent="Cosmetic filtering enabled"
                                                    Toggled="ShieldCosmeticToggle_Toggled" />

                                                <ToggleSwitch
                                                    x:Name="ShieldYoutubeToggle"
                                                    Header="YouTube clean mode"
                                                    OffContent="Use the selected engine only"
                                                    OnContent="Hide promoted cards, overlays and press Skip automatically"
                                                    Toggled="ShieldYoutubeToggle_Toggled" />

                                                <StackPanel Spacing="7">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="Custom filters" />
                                                    <TextBox
                                                        x:Name="ShieldRulesTextBox"
                                                        MinHeight="68"
                                                        MaxHeight="100"
                                                        AcceptsReturn="True"
                                                        TextWrapping="NoWrap"
                                                        PlaceholderText="||example-ad-domain.com^&#x0a;example.com##.sponsored" />
                                                    <Button
                                                        Height="30"
                                                        HorizontalAlignment="Left"
                                                        Padding="12,0"
                                                        Click="ApplyShieldRulesButton_Click"
                                                        Content="Apply rules" />
                                                </StackPanel>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        Height="32"
                                                        HorizontalAlignment="Stretch"
                                                        Click="ReloadShieldButton_Click"
                                                        Content="Reload page" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Height="32"
                                                        HorizontalAlignment="Stretch"
                                                        Click="UpdateShieldListsButton_Click"
                                                        Content="Update filters" />
                                                </Grid>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            x:Name="ShieldStatusText"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource AeroMutedTextBrush}"
                                                            Text="Built-in protection is active" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource AeroMutedTextBrush}"
                                                            Text="Filter sources: EasyList + EasyPrivacy" />
                                                    </StackPanel>
                                                    <HyperlinkButton
                                                        Grid.Column="1"
                                                        Padding="6,0"
                                                        VerticalAlignment="Bottom"
                                                        Click="UblockOriginLink_Click"
                                                        FontSize="10"
                                                        Content="uBlock Origin ↗" />
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon x:Name="ShieldIcon" FontSize="12" Glyph="&#xE83D;" />
                        </Button>

                        <Button
                            x:Name="SitePermissionsButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Site information and permissions"
                    ToolTipService.ToolTip="Site information and permissions">
                            <Button.Flyout>
                                <Flyout
                                    x:Name="SitePermissionsFlyout"
