                        AutomationProperties.Name="Close"
                    ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
