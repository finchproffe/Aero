        <!-- Hosts the tab strip when it sits below the toolbar, at the bottom or on a side. -->
        <Border
            x:Name="HorizontalTabDock"
            Grid.Row="2"
            Background="{ThemeResource AeroTitleBarBrush}"
            BorderBrush="{ThemeResource AeroSoftBorderBrush}"
            Visibility="Collapsed" />

        <Border
            x:Name="VerticalTabDock"
            Grid.Row="5"
            Padding="6,6,6,6"
            HorizontalAlignment="Left"
            Background="{ThemeResource AeroTitleBarBrush}"
            BorderBrush="{ThemeResource AeroSoftBorderBrush}"
            Visibility="Collapsed" />

        <Border
            x:Name="BookmarksBar"
            Grid.Row="3"
            Padding="7,2"
            Background="{ThemeResource AeroToolbarBrush}"
            BorderBrush="{ThemeResource AeroSoftBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel
                        x:Name="BookmarksBarItemsPanel"
                        AllowDrop="True"
                        DragOver="BookmarksBarItemsPanel_DragOver"
                        Drop="BookmarksBarItemsPanel_Drop"
                        Orientation="Horizontal"
                        Spacing="4" />
                </ScrollViewer>
                <Button
                    x:Name="BookmarksBarAddButton"
                    Grid.Column="1"
                    Width="26"
                    Height="26"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="BookmarksBarAddButton_Click"
                    AutomationProperties.Name="Add bookmark"
                    ToolTipService.ToolTip="Add bookmark">
                    <FontIcon FontSize="11" Glyph="&#xE710;" />
                </Button>
            </Grid>
        </Border>

        <ProgressBar
            x:Name="PageProgress"
            Grid.Row="4"
            Height="2"
            IsIndeterminate="True"
            Visibility="Collapsed"
            Foreground="{ThemeResource AeroAccentBrush}" />

        <Grid
            x:Name="BrowserHost"
            Grid.Row="5"
            AllowDrop="True"
            DragEnter="BrowserHostFileDrop_DragEnter"
            DragLeave="BrowserHostFileDrop_DragLeave"
            DragOver="BrowserHostFileDrop_DragOver"
            Drop="BrowserHostFileDrop_Drop"
            Background="{ThemeResource AeroWindowBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SplitLeftColumn" Width="*" MinWidth="0" />
                <ColumnDefinition x:Name="SplitDividerColumn" Width="0" />
                <ColumnDefinition x:Name="SplitRightColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SplitLeftActiveOutline"
                Grid.Column="0"
                Margin="2"
                Canvas.ZIndex="90"
                BorderBrush="{ThemeResource AeroAccentBrush}"
                BorderThickness="2"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <Border
                x:Name="SplitRightActiveOutline"
                Grid.Column="2"
                Margin="2"
                Canvas.ZIndex="90"
                BorderBrush="{ThemeResource AeroAccentBrush}"
                BorderThickness="2"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!-- Snap-style handle: resize cursor and a grip that lights up while hovered or dragged. -->
            <local:SplitDividerHandle
                x:Name="SplitDivider"
                Grid.Column="1"
                Canvas.ZIndex="120"
                Background="Transparent"
                AutomationProperties.Name="Resize split panes"
                PointerCaptureLost="SplitDivider_PointerCaptureLost"
                PointerEntered="SplitDivider_PointerEntered"
                PointerExited="SplitDivider_PointerExited"
                PointerMoved="SplitDivider_PointerMoved"
                PointerPressed="SplitDivider_PointerPressed"
                PointerReleased="SplitDivider_PointerReleased"
                Visibility="Collapsed">
                <Border
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AeroSoftBorderBrush}" />
                <Border
                    Width="4"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AeroSoftBorderBrush}"
                    CornerRadius="2" />
                <Border
                    x:Name="SplitDividerGripHighlight"
                    Width="4"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AeroAccentBrush}"
                    CornerRadius="2"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
            </local:SplitDividerHandle>

            <Border
                x:Name="SplitViewToolbar"
                Grid.ColumnSpan="3"
                Margin="0,8,0,0"
                Padding="5,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Canvas.ZIndex="140"
                Background="{ThemeResource AeroRaisedSurfaceBrush}"
                BorderBrush="{ThemeResource AeroSoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Width="30"
                        Height="28"
                        Style="{StaticResource ChromeIconButtonStyle}"
                        Click="SwapSplitPanesButton_Click"
                        AutomationProperties.Name="Swap split panes"
                    ToolTipService.ToolTip="Swap split panes">
                        <FontIcon FontSize="12" Glyph="&#xE8AB;" />
                    </Button>
                    <Button
                        Width="30"
                        Height="28"
                        Style="{StaticResource ChromeIconButtonStyle}"
                        Click="ExitSplitViewButton_Click"
                        AutomationProperties.Name="Exit Split View"
                    ToolTipService.ToolTip="Exit Split View">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lightweight find-on-page bar. -->
        <Border
            x:Name="FindBar"
            Grid.Row="5"
            Canvas.ZIndex="35"
            Width="360"
            Height="46"
            Margin="0,8,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Padding="8"
            Background="{ThemeResource AeroRaisedSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="FindBarTransform" TranslateY="-8" />
            </Border.RenderTransform>

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="FindBox"
                    Grid.Column="0"
                    Style="{StaticResource FindTextBoxStyle}"
                    PlaceholderText="Find on this page"
                    TextChanged="FindBox_TextChanged"
                    KeyDown="FindBox_KeyDown" />

                <TextBlock
                    x:Name="FindStatusText"
                    Grid.Column="1"
                    MinWidth="42"
                    Margin="3,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource AeroMutedTextBrush}"
                    FontSize="12"
                    Text="Find" />

                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="FindPreviousButton_Click"
                    AutomationProperties.Name="Previous match (Shift+F3)"
                    ToolTipService.ToolTip="Previous match (Shift+F3)">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </Button>

                <Button
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="FindNextButton_Click"
                    AutomationProperties.Name="Next match (Enter)"
                    ToolTipService.ToolTip="Next match (Enter)">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>

                <Button
                    Grid.Column="4"
                    Width="28"
                    Height="28"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Click="CloseFindButton_Click"
                    AutomationProperties.Name="Close find"
                    ToolTipService.ToolTip="Close find">
                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <!-- History and bookmarks library. -->
        <Border
            x:Name="LibraryPane"
            Grid.Row="5"
            Canvas.ZIndex="40"
            Width="360"
            HorizontalAlignment="Right"
            Background="{ThemeResource AeroSurfaceBrush}"
            BorderBrush="{ThemeResource AeroBorderBrush}"
            BorderThickness="1,0,0,0"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="LibraryPaneTransform" TranslateX="24" />
            </Border.RenderTransform>

            <Grid Padding="15,13,15,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LibraryTitleText" FontSize="18" FontWeight="SemiBold" Text="History" />
                        <TextBlock Foreground="{ThemeResource AeroMutedTextBrush}" FontSize="12" Text="Stored only on this computer" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource ChromeIconButtonStyle}"
