<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Aero.Security</RootNamespace>
    <AssemblyName>Aero.Security</AssemblyName>
    <Version>0.26.0.0</Version>
    <FileVersion>0.26.0.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows.Security.* and UserConsentVerifierInterop come from the Windows
         target framework projection. Keeping Microsoft.WindowsAppSDK here made
         the package flow transitively into the standalone Broker executable and
         incorrectly turned it into a Windows App SDK framework-dependent app. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <!-- The anti-stealer core is Rust (src/Aero.Security.Native). Cargo builds it for the target
       platform and the DLL ships next to every assembly that references Aero.Security. -->
  <PropertyGroup>
    <AeroNativeCrateDir>$(MSBuildThisFileDirectory)..\Aero.Security.Native\</AeroNativeCrateDir>
    <AeroRustTarget Condition="'$(Platform)' == 'ARM64' or $(RuntimeIdentifier.EndsWith('arm64'))">aarch64-pc-windows-msvc</AeroRustTarget>
    <AeroRustTarget Condition="'$(AeroRustTarget)' == ''">x86_64-pc-windows-msvc</AeroRustTarget>
    <AeroCargoTargetDir>$(MSBuildThisFileDirectory)obj\cargo</AeroCargoTargetDir>
    <AeroNativeDll>$(AeroCargoTargetDir)\$(AeroRustTarget)\release\aero_security_native.dll</AeroNativeDll>
  </PropertyGroup>

  <ItemGroup>
    <AeroNativeSource Include="$(AeroNativeCrateDir)src\**\*.rs;$(AeroNativeCrateDir)Cargo.toml;$(AeroNativeCrateDir)Cargo.lock" />
    <Content Include="$(AeroNativeDll)" Link="aero_security_native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildAeroSecurityNative" BeforeTargets="BeforeBuild" Inputs="@(AeroNativeSource)" Outputs="$(AeroNativeDll)">
    <Exec Command="cargo build --release --locked --manifest-path &quot;$(AeroNativeCrateDir)Cargo.toml&quot; --target $(AeroRustTarget) --target-dir &quot;$(AeroCargoTargetDir)&quot;"
          CustomErrorRegularExpression="^error" />
    <Error Condition="!Exists('$(AeroNativeDll)')"
           Text="aero_security_native.dll was not built. Install Rust (rustup target add $(AeroRustTarget)) and the MSVC C++ build tools for this platform." />
  </Target>
</Project>
